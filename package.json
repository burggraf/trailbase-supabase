    "test:sdk:package": "node scripts/run-sdk-package.mjs",
    "test:sdk:unit": "vitest run tests/unit/sdk-*.test.ts",
    "test:sdk:browser": "node scripts/run-phase-a.mjs sdk-browser",
    "test:sdk:refresh": "node scripts/run-phase-a.mjs sdk-refresh",
    "test:sdk:auth": "node scripts/run-phase-a.mjs sdk-auth",
    "test:sdk:data": "node scripts/run-phase-a.mjs sdk-data",
    "progress": "node scripts/progress.mjs",
    "test:unit": "node scripts/run-unit.mjs",
    "test:phase-a": "node scripts/run-phase-a.mjs",
    "test:cleanup": "node scripts/run-phase-a.mjs lifecycle",
    "test:phase-a:browser": "node scripts/run-phase-a.mjs browser",
    "fixtures:cleanup": "node scripts/cleanup.mjs",
    "tools:install": "node scripts/tools.mjs",
    "test:db": "node scripts/run-phase-a.mjs database",
    "test:integration": "node scripts/run-phase-a.mjs characterization",
    "test:contract": "node scripts/incomplete.mjs contract",
    "test:security": "node scripts/incomplete.mjs security",
    "test:e2e": "node scripts/incomplete.mjs e2e",
    "test:package": "node scripts/incomplete.mjs package",
    "test:all": "node scripts/incomplete.mjs all"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "22.19.15",
    "supabase": "2.119.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "trailbase": "0.14.3"
  }
}
